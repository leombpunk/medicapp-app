{
    "name": "medicapp",
    "version": "1.0.1",
    "private": true,
    "main": "electron/main.js",
    "dependencies": {
        "@fontsource/ubuntu": "^5.2.7",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.9.2",
        "axios": "^1.21.0",
        "bootstrap": "^5.3.8",
        "chart.js": "^4.5.1",
        "js-file-download": "^0.4.12",
        "react": "^19.3.1",
        "react-bootstrap": "^2.10.10",
        "react-chartjs-2": "^5.3.0",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.65.0",
        "react-router-dom": "^7.9.0",
        "yup": "^1.7.1"
    },
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "build-electron": "mkdir build/src && cp -r electron/. build/electron && cp -r src/shared/. build/src/shared",
        "package-linux": "electron-builder build --linux -c.extraMetadata.main=build/electron/main.js --publish never",
        "package-windows": "electron-builder build --windows -c.extraMetadata.main=build/electron/main.js --publish never",
        "electron": "electron http://localhost:5173"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^43.8.7",
        "electron-builder": "^26.15.3",
        "vite": "^7.3.7"
    },
    "build": {
        "appId": "medicapp",
        "linux": {
            "target": "AppImage"
        }
    }
}
